#!/bin/sh
export PATH=/bin:/usr/bin:/sbin:/usr/sbin
/bin/busybox --install -s /bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
# virtio MMIO discovery order may reverse the command-line disk order.
root_device= data_device=
for device in /dev/vd?; do
    if mount -t squashfs -o ro "$device" /lower 2>/dev/null; then
        root_device=$device
        break
    fi
done
[ -n "$root_device" ] || exec sh
for device in /dev/vd?; do
    [ "$device" != "$root_device" ] || continue
    if mount -t ext4 "$device" /lower/userdata 2>/dev/null; then
        data_device=$device
        break
    fi
done
[ -n "$data_device" ] || exec sh
mkdir -p /lower/userdata/host
mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=262144 analysis /lower/userdata/host || exec sh
mkdir -p /lower/userdata/results
# Optional output-only share avoids freezing the running game for screenshots.
mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144 results /lower/userdata/results 2>/dev/null || true
mount --bind /dev /lower/dev
mount --bind /proc /lower/proc
mount --bind /sys /lower/sys
mount -t tmpfs tmpfs /lower/tmp
mount -t tmpfs tmpfs /lower/run
hostname knulli
ip link set lo up
cp /bin/busybox /lower/userdata/busybox
chroot /lower /bin/bash /userdata/host/emulator/shared/guest-test.sh
printf '\nGuest test ended; interactive rescue shell follows.\n'
exec chroot /lower /bin/bash
