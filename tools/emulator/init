#!/bin/sh
export PATH=/bin
/bin/busybox --install -s /bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
# virtio MMIO discovery order may reverse the command-line disk order.
root_device= data_device=
for device in /dev/vd?; do
    case "$(blkid "$device")" in
        *'TYPE="squashfs"'*) root_device=$device ;;
        *'TYPE="ext4"'*) data_device=$device ;;
    esac
done
[ -n "$root_device" ] && [ -n "$data_device" ] || exec sh
mount -t squashfs -o ro "$root_device" /lower || exec sh
mount -t ext4 "$data_device" /lower/userdata || exec sh
mkdir -p /lower/userdata/host
mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=262144 analysis /lower/userdata/host || exec sh
mount --bind /dev /lower/dev
mount --bind /proc /lower/proc
mount --bind /sys /lower/sys
mount -t tmpfs tmpfs /lower/tmp
mount -t tmpfs tmpfs /lower/run
hostname knulli
ip link set lo up
cp /bin/busybox /lower/userdata/busybox
chroot /lower /bin/bash /userdata/host/emulator/shared/guest-test.sh
printf '\nGuest test ended; interactive rescue shell follows.\n'
exec chroot /lower /bin/bash
